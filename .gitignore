# Repo-wide ignores only.
# App-specific build artifacts live in each subproject's own .gitignore:
#   - frontend-mobile/.gitignore  (Expo/Metro/native — tool-managed)
#   - backend/.gitignore          (Node/dist/logs)

# Claude Code local config
.claude

# Dependencies (safety net; each app also ignores its own)
node_modules/

# Local env files — secrets are never committed
.env
.env*.local

# OS / editor
.DS_Store
*.pem

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
