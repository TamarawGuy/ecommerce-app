# Clerk publishable key — from the Clerk Dashboard → API keys. Required for auth.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Stripe publishable key — from the Stripe Dashboard → Developers → API keys.
# Required for checkout (the PaymentSheet). Use the test key (pk_test_...).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Optional. If unset, the app auto-detects the dev machine's host (the one
# running `expo start`) on port 4000 — which works for simulators and physical
# devices on the same network. Set this only to override.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:4000
