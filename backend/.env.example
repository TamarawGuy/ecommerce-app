# Neon Postgres pooled connection string (host contains "-pooler").
# Copy this file to `.env` and fill in your value. `.env` is git-ignored.
NEON_DB_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Server
PORT=4000

# Clerk — from the Clerk Dashboard → API keys. Required for auth.
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# From Clerk Dashboard → Webhooks → your endpoint (signing secret, "whsec_...").
# Optional until you provision the webhook endpoint (needs a public URL, e.g.
# ngrok or Render). /webhooks/clerk returns 503 until this is set.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
